+    Concat,
+    BitwiseAnd,
+    BitwiseOr,
+    BitwiseXor,
+    ShiftLeft,
+    ShiftRight,
+    Negate,
+    BitwiseNot,
+    Length,
+    Less,
+    LessEqual,
+}
